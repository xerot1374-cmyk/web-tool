# Copy this file to `.env` for host-side local development if you do not already
# have one. The Docker Compose stack sets its own container-side database URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/social_media_tool?schema=public"

# Leave this unset for local browser launches. The Docker Compose app container
# sets the Chromium path explicitly.
PUPPETEER_EXECUTABLE_PATH=
