# Copy this file to `.env` for host-side local development if you do not already
# have one.
APP_PORT=3100
DB_BIND_ADDRESS=127.0.0.1
DB_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=social_media_tool
POSTGRES_VOLUME=web-tool_postgres-data
NODE_MODULES_VOLUME=web-tool_node-modules
NEXT_CACHE_VOLUME=web-tool_next-cache

DATABASE_URL="postgresql://postgres:change-me-to-a-long-random-value@localhost:5432/social_media_tool?schema=public"
NEXT_ALLOWED_DEV_ORIGINS=

# Leave this unset for local browser launches. The Docker Compose app container
# sets the Chromium path explicitly.
PUPPETEER_EXECUTABLE_PATH=
